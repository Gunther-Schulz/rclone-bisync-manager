# Base path for local files to be synced
local_base_path: /path/to/your/local/base/directory

# An rclone FILTERS file: every rule starts with '-' (exclude) or '+' (include), e.g. "- *.tmp".
# Passed to rclone as --filters-file. If it changes, affected jobs resync before syncing again --
# rclone requires that, because newly-excluded files vanish from its listings and bisync would
# otherwise mistake them for deletions and delete them for real on the other side.
exclusion_rules_file: /path/to/your/filter.txt

# Redirect rclone log output
redirect_rclone_log_output: true

# CPU usage limit as a percentage. 100 = no limit (cpulimit is not used at all).
max_cpu_usage_percent: 100

# On daemon start, run jobs whose scheduled time passed while the daemon was stopped.
# A job that has never synced hasn't "missed" anything: it just waits for its next cron time.
run_missed_jobs: true

# Sync EVERY active job once whenever the daemon starts. This is how you deliberately kick off a
# new job's first resync -- which for a large remote is a full, hours-long transfer. Leave it off
# unless you want that on every daemon start; `rclone-bisync-manager sync <job>` does it once.
run_initial_sync_on_startup: false

# Optional: daemon log file rotation (empty = use defaults: 5 MB max size, 5 backups)
# log_rotation_max_mb: 5
# log_rotation_backup_count: 5

# Define the paths to be synchronized
sync_jobs:
  example_job:
    local: example_folder
    rclone_remote: your_remote
    remote: path/on/remote/storage
    schedule: "*/30 * * * *" # Every 30 minutes
    dry_run: false
    rclone_options:
      log_level: Notice
  example_job_2:
    local: another_folder
    rclone_remote: second_remote
    remote: another/path/on/remote
    schedule: "0 */2 * * *" # Every 2 hours
    dry_run: false
    rclone_options: # Overriding the default options
      log_level: Notice

# Rclone options
rclone_options:
  recover: null
  resilient: null
  # PERCENTAGE of files, not a file count. Bisync aborts the run if more than this
  # share of files would be deleted. rclone's own default is 50.
  max_delete: 20
  log_level: INFO
  max_lock: 15m
  retries: 3
  low_level_retries: 10
  compare: "size,modtime,checksum"
  create_empty_src_dirs: null
  # Optional, off by default: require an RCLONE_TEST marker file on BOTH sides before
  # syncing. Enable it for removable/network mounts that could silently appear empty.
  # If you enable it you must create the marker yourself -- see the README.
  # check_access: null
  # Changing this list changes which files rclone sees, so the affected jobs will resync before
  # their next sync. That is deliberate -- without it, the files you just started excluding would
  # look deleted and get deleted for real on the other side.
  exclude:
    - "*.tmp"
    - "*.log"
    - "._*"
    - ".DS_Store"
    - ".Spotlight-V100/**"
    - ".Trashes/**"
    - ".fseventsd/**"
    - ".AppleDouble/**"
    - ".VolumeIcon.icns"

# Bisync-specific options
bisync_options:
  conflict_resolve: newer
  conflict_loser: num
  conflict_suffix: rc-conflict
  track_renames: null
  # Add any additional bisync-specific options here
  # custom_bisync_option: value

# Resync-specific options
resync_options:
  error_on_no_transfer: null
  # Add any additional resync-specific options here
  # custom_resync_option: value